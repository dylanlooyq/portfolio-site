{
  "name": "portfolio-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Everything else is served straight from the assets layer; only the video runs the Worker.
    "run_worker_first": ["/assets/video/*.mp4"]
  }
}
